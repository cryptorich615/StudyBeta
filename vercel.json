{
  "framework": "nextjs",
  "buildCommand": "cd studyclaw && npm install && cd apps/web && npm install && npm run build",
  "outputDirectory": "studyclaw/apps/web/.next",
  "installCommand": "cd studyclaw && npm install",
  "devCommand": "cd studyclaw/apps/web && npm run dev",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://ec2-3-148-233-46.us-east-2.compute.amazonaws.com:4000/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
